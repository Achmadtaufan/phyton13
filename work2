;WITH CTE AS
(
    SELECT
        menuName,
        CAST([query] AS VARCHAR(MAX)) AS queryText
    FROM comp
),
Keywords AS
(
    SELECT ' FROM ' AS Keyword
    UNION ALL SELECT ' JOIN '
    UNION ALL SELECT ' LEFT JOIN '
    UNION ALL SELECT ' RIGHT JOIN '
    UNION ALL SELECT ' INNER JOIN '
    UNION ALL SELECT ' FULL JOIN '
    UNION ALL SELECT ' LEFT OUTER JOIN '
    UNION ALL SELECT ' RIGHT OUTER JOIN '
    UNION ALL SELECT ' FULL OUTER JOIN '
    UNION ALL SELECT ' CROSS JOIN '
),
FindAll AS
(
    -- Posisi keyword pertama
    SELECT
        c.menuName,
        c.queryText,
        KeywordPosition =
        (
            SELECT MIN(p)
            FROM
            (
                SELECT NULLIF(CHARINDEX(k.Keyword, ' ' + UPPER(c.queryText) + ' '), 0) p
                FROM Keywords k
            ) x
        )
    FROM CTE c

    UNION ALL

    -- Cari keyword berikutnya
    SELECT
        r.menuName,
        r.queryText,
        KeywordPosition =
        (
            SELECT MIN(p)
            FROM
            (
                SELECT
                    NULLIF(
                        CHARINDEX(
                            k.Keyword,
                            ' ' + UPPER(r.queryText) + ' ',
                            r.KeywordPosition + 1
                        ),
                        0
                    ) p
                FROM Keywords k
            ) x
        )
    FROM FindAll r
    WHERE r.KeywordPosition > 0
),
ExtractObject AS
(
    SELECT
        menuName,

        objectRaw =
            LTRIM(RTRIM(
                LEFT(
                    SUBSTRING(
                        queryText,
                        KeywordPosition + 1,
                        LEN(queryText)
                    ),
                    CHARINDEX(
                        ' ',
                        SUBSTRING(
                            queryText,
                            KeywordPosition + 1,
                            LEN(queryText)
                        ) + ' '
                    ) - 1
                )
            ))
    FROM FindAll
    WHERE KeywordPosition > 0
),
FinalData AS
(
    SELECT
        menuName,

        objectName =
            CASE
                WHEN objectRaw LIKE '%.%'
                    THEN PARSENAME(
                        REPLACE(
                            REPLACE(objectRaw, '[', ''),
                            ']',
                            ''
                        ),
                        1
                    )
                ELSE
                    REPLACE(
                        REPLACE(objectRaw, '[', ''),
                        ']',
                        ''
                    )
            END
    FROM ExtractObject
)
SELECT DISTINCT
    menuName,
    objectName
FROM FinalData
WHERE NULLIF(LTRIM(RTRIM(objectName)), '') IS NOT NULL
  AND objectName <> '('
  AND UPPER(REPLACE(objectName, ' ', '')) <> '(SELECT'
ORDER BY
    menuName,
    objectName
OPTION (MAXRECURSION 0);