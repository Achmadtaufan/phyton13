;WITH SourceData AS
(
    SELECT
        menuName,
        queryText = CAST([query] AS VARCHAR(MAX))
    FROM comp
),
CleanData AS
(
    SELECT
        menuName,
        queryText =
            REPLACE(
                REPLACE(
                    REPLACE(
                        REPLACE(
                            REPLACE(
                                queryText,
                                CHAR(13), ' '
                            ),
                            CHAR(10), ' '
                        ),
                        CHAR(9), ' '
                    ),
                    '  ', ' '
                ),
                '  ', ' '
            )
    FROM SourceData
),
NormalizeJoin AS
(
    SELECT
        menuName,
        queryText =
            REPLACE(
                REPLACE(
                    REPLACE(
                        REPLACE(
                            REPLACE(
                                REPLACE(
                                    REPLACE(
                                        REPLACE(
                                            REPLACE(
                                                REPLACE(
                                                    UPPER(queryText) COLLATE Latin1_General_CI_AS,
                                                    ' LEFT OUTER JOIN ', '|'
                                                ),
                                                ' RIGHT OUTER JOIN ', '|'
                                            ),
                                            ' FULL OUTER JOIN ', '|'
                                        ),
                                        ' LEFT JOIN ', '|'
                                    ),
                                    ' RIGHT JOIN ', '|'
                                ),
                                ' INNER JOIN ', '|'
                            ),
                            ' FULL JOIN ', '|'
                        ),
                        ' CROSS JOIN ', '|'
                    ),
                    ' OUTER APPLY ', '|'
                ),
                ' CROSS APPLY ', '|'
            )
    FROM CleanData
),
NormalizeAll AS
(
    SELECT
        menuName,
        queryText =
            REPLACE(
                REPLACE(
                    queryText,
                    ' JOIN ', '|'
                ),
                ' FROM ', '|'
            )
    FROM NormalizeJoin
),
FindObjects AS
(
    -- Ambil object pertama setelah FROM/JOIN
    SELECT
        menuName,
        queryText,
        StartPos = 1,
        EndPos =
            CHARINDEX('|', queryText + '|')
    FROM NormalizeAll

    UNION ALL

    -- Cari FROM/JOIN berikutnya
    SELECT
        menuName,
        queryText,
        StartPos = EndPos + 1,
        EndPos =
            CHARINDEX(
                '|',
                queryText + '|',
                EndPos + 1
            )
    FROM FindObjects
    WHERE EndPos > 0
),
Parts AS
(
    SELECT
        menuName,
        part =
            LTRIM(
                RTRIM(
                    SUBSTRING(
                        queryText,
                        StartPos,
                        EndPos - StartPos
                    )
                )
            )
    FROM FindObjects
    WHERE EndPos > StartPos
),
FirstToken AS
(
    SELECT
        menuName,
        token =
            CASE
                WHEN LEFT(part, 1) = '('
                    THEN NULL
                ELSE
                    LEFT(
                        part,
                        CHARINDEX(' ', part + ' ') - 1
                    )
            END
    FROM Parts
),
CleanObject AS
(
    SELECT
        menuName,
        objectName =
            CASE
                WHEN token IS NULL THEN NULL

                -- Function: dbo.fn_test(...) 
                WHEN CHARINDEX('(', token) > 0
                    THEN LEFT(
                        token,
                        CHARINDEX('(', token) - 1
                    )

                ELSE token
            END
    FROM FirstToken
)
SELECT DISTINCT
    menuName,
    objectName =
        CASE
            WHEN CHARINDEX('.', objectClean) > 0
                THEN RIGHT(
                    objectClean,
                    CHARINDEX(
                        '.',
                        REVERSE(objectClean)
                    ) - 1
                )
            ELSE objectClean
        END
FROM
(
    SELECT
        menuName,
        objectClean =
            REPLACE(
                REPLACE(
                    LTRIM(RTRIM(objectName)),
                    '[', ''
                ),
                ']', ''
            )
    FROM CleanObject
    WHERE objectName IS NOT NULL
) X
WHERE NULLIF(objectClean, '') IS NOT NULL
  AND objectClean <> '('
  AND UPPER(objectClean) <> 'SELECT'
OPTION (MAXRECURSION 0);