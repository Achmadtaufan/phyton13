;WITH Q AS
(
    SELECT
        menuName,
        CAST([query] AS VARCHAR(MAX)) AS queryText
    FROM comp
),
N AS
(
    SELECT
        menuName,
        queryText =
            REPLACE(
                REPLACE(
                    REPLACE(
                        REPLACE(
                            REPLACE(
                                REPLACE(
                                    REPLACE(
                                        REPLACE(
                                            REPLACE(
                                                REPLACE(
                                                    REPLACE(
                                                        queryText,
                                                        CHAR(13), ' '
                                                    ),
                                                    CHAR(10), ' '
                                                ),
                                                CHAR(9), ' '
                                            ),
                                            ' LEFT OUTER JOIN ', CHAR(30)
                                        ),
                                        ' RIGHT OUTER JOIN ', CHAR(30)
                                    ),
                                    ' FULL OUTER JOIN ', CHAR(30)
                                ),
                                ' LEFT JOIN ', CHAR(30)
                            ),
                            ' RIGHT JOIN ', CHAR(30)
                        ),
                        ' INNER JOIN ', CHAR(30)
                    ),
                    ' FULL JOIN ', CHAR(30)
                ),
                ' CROSS JOIN ', CHAR(30)
            )
    FROM Q
),
N2 AS
(
    SELECT
        menuName,
        queryText =
            REPLACE(
                REPLACE(
                    REPLACE(
                        queryText,
                        ' OUTER APPLY ', CHAR(30)
                    ),
                    ' CROSS APPLY ', CHAR(30)
                ),
                ' JOIN ', CHAR(30)
            )
    FROM N
),
N3 AS
(
    SELECT
        menuName,
        queryText =
            REPLACE(
                queryText,
                ' FROM ',
                CHAR(30)
            )
    FROM N2
),
S AS
(
    SELECT
        menuName,
        part = LTRIM(RTRIM(value))
    FROM N3
    CROSS APPLY STRING_SPLIT(queryText, CHAR(30))
),
O AS
(
    SELECT
        menuName,
        objectRaw =
            CASE
                WHEN LEFT(part, 1) = '(' THEN NULL
                ELSE
                    LEFT(
                        part,
                        CHARINDEX(' ', part + ' ') - 1
                    )
            END
    FROM S
),
O2 AS
(
    SELECT
        menuName,
        objectRaw =
            CASE
                WHEN objectRaw IS NULL THEN NULL
                WHEN CHARINDEX('(', objectRaw) > 0
                    THEN LEFT(
                        objectRaw,
                        CHARINDEX('(', objectRaw) - 1
                    )
                ELSE objectRaw
            END
    FROM O
)
SELECT DISTINCT
    menuName,
    objectName =
        CASE
            WHEN CHARINDEX('.', cleanedObject) > 0
                THEN RIGHT(
                    cleanedObject,
                    CHARINDEX('.', REVERSE(cleanedObject)) - 1
                )
            ELSE cleanedObject
        END
FROM
(
    SELECT
        menuName,
        cleanedObject =
            REPLACE(
                REPLACE(
                    LTRIM(RTRIM(objectRaw)),
                    '[', ''
                ),
                ']', ''
            )
    FROM O2
    WHERE objectRaw IS NOT NULL
) X
WHERE NULLIF(cleanedObject, '') IS NOT NULL
  AND UPPER(cleanedObject) <> 'SELECT'
ORDER BY
    menuName,
    objectName;